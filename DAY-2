18_Sum_Of_Digits_Of_A_Number
#include <stdio.h>

 int main()
{
  int n,sum=0,d;
  scanf("%d",&n);
  while(n!=0)
  {
      d=n%10;
      sum=sum+d;
      n=n/10;
  }
  printf("%d",sum);
}


