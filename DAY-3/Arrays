44_Read_And_Print_2D_Array
#include<stdio.h>
int main()
{
    int row,col,i,j;
    scanf("%d%d",&row,&col);
    int arr[row][col];
    for(i=0;i<row;i++)
   {
       for(j=0;j<col;j++)
       scanf("%d",&arr[i][j]);
   }
    printf("output is:\n");
    for(i=0;i<row;i++,printf("|\n"))
    {
        for(j=0;j<col;j++)
        printf("%d ",arr[i][j]);
    }
}
