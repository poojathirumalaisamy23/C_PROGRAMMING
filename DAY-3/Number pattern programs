

29_Print_Number_1_Square_Pattern
#include<stdio.h>
int main()
{
    int n,row,col;
    scanf("%d",&n);
    for(row=0;row<n;row++,printf("\n"))
    {
        for(col=0;col<n;col++)
        printf("1");
      
    }
}

30_Print_Column_Number_Pattern
#include<stdio.h>
int main()
{
    int n,row,col;
    scanf("%d",&n);
    for(row=0;row<n;row++,printf("\n"))
    {
        for(col=0;col<n;col++)
        printf("%d",col+1);
      
    }
}

