32_Print_Increasing_Row_Number_Pattern
#include<stdio.h>
int main()
{
    int n,row,col;
    scanf("%d",&n);
    for(row=0;row<n;row++,printf("\n"))
    {
        for(col=0;col<=row;col++)
        printf("%d",row+1);
      
    }
}

33_Print_Inverted_Number_Pattern
#include<stdio.h>
int main()
{
    int n,row,col;
    scanf("%d",&n);
    for(row=0;row<n;row++,printf("\n"))
    {
        for(col=0;col<n-row;col++)
        printf("%d",col+1);
      
    }
  }

